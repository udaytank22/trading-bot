generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  password              String
  refreshToken          String?
  gmailAccessToken      String?
  gmailRefreshToken     String?
  outlookAccessToken    String?
  outlookRefreshToken   String?
  outlookAccountId      String?
  roleId                Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  createdById           Int?
  updatedById           Int?
  isActive              Boolean                @default(true)
  employeeProfileId     Int?                   @unique
  approvalLogs          ApprovalLog[]
  auditLogs             AuditLog[]
  documentsUploaded     Document[]             @relation("DocumentUploader")
  assignedInquiries     Inquiry[]              @relation("AssignedEmployee")
  assignedLeadInquiries Inquiry[]              @relation("AssignedLead")
  inquiriesCreated      Inquiry[]              @relation("InquiryCreator")
  inquiriesUpdated      Inquiry[]              @relation("InquiryUpdater")
  statusHistories       InquiryStatusHistory[]
  notifications         Notification[]
  employeeProfile       Employee?              @relation(fields: [employeeProfileId], references: [id])
  role                  Role                   @relation(fields: [roleId], references: [id])
  sentMessages          Message[]              @relation("SentMessages")
  receivedMessages      Message[]              @relation("ReceivedMessages")

  @@index([roleId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  users       User[]

  @@index([createdAt])
  @@index([deletedAt])
}

model Permission {
  id              Int              @id @default(autoincrement())
  module          String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isActive        Boolean          @default(true)
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([createdAt])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Client {
  id             Int             @id @default(autoincrement())
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  createdById    Int?
  updatedById    Int?
  isActive       Boolean         @default(true)
  vessels        ClientVessel[]
  inquiries      Inquiry[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]

  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model ClientVessel {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String
  imoNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
}

model Supplier {
  id             Int               @id @default(autoincrement())
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  categories     String[]          @default([])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  createdById    Int?
  updatedById    Int?
  isActive       Boolean           @default(true)
  inquiries      InquirySupplier[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]
  supplierQuotes SupplierQuote[]

  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String
  impa               String              @unique
  category           String?
  unit               String?
  sellingPrice       Decimal             @db.Decimal(12, 2)
  purchasePrice      Decimal             @db.Decimal(12, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdById        Int?
  updatedById        Int?
  isActive           Boolean             @default(true)
  inquiryItems       InquiryItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model Inquiry {
  id                   Int                    @id @default(autoincrement())
  inquiryNumber        String                 @unique
  clientId             Int
  vesselName           String?
  imoNumber            String?
  referenceNumber      String?
  currentStatus        String                 @default("PENDING")
  assignedEmployeeId   Int?
  assignedTeamLeadId   Int?
  expectedDeliveryDate DateTime?
  remarks              String?
  // Inventory auto-fulfillment fields
  inventoryFulfilled   Boolean                @default(false)
  supplyStatus         String?
  dispatchStatus       String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  createdById          Int?
  updatedById          Int?
  isActive             Boolean                @default(true)
  approvalLogs         ApprovalLog[]
  clientQuotations     ClientQuotation[]
  assignedEmployee     User?                  @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedTeamLead     User?                  @relation("AssignedLead", fields: [assignedTeamLeadId], references: [id])
  client               Client                 @relation(fields: [clientId], references: [id])
  createdBy            User?                  @relation("InquiryCreator", fields: [createdById], references: [id])
  updatedBy            User?                  @relation("InquiryUpdater", fields: [updatedById], references: [id])
  items                InquiryItem[]
  statusHistory        InquiryStatusHistory[]
  suppliers            InquirySupplier[]
  invoices             Invoice[]
  purchaseOrders       PurchaseOrder[]
  shipments            Shipment[]
  supplierQuotes       SupplierQuote[]

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([assignedTeamLeadId])
  @@index([createdById])
  @@index([updatedById])
  @@index([currentStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model InquiryItem {
  id                   Int                   @id @default(autoincrement())
  inquiryId            Int
  productId            Int?
  description          String
  quantity             Int
  unit                 String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  clientQuotationItems ClientQuotationItem[]
  inquiry              Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product              Product?              @relation(fields: [productId], references: [id])
  supplierQuoteItems   SupplierQuoteItem[]

  @@index([inquiryId])
  @@index([productId])
  @@index([createdAt])
}

model InquirySupplier {
  id         Int      @id @default(autoincrement())
  inquiryId  Int
  supplierId Int
  createdAt  DateTime @default(now())
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@index([inquiryId])
  @@index([supplierId])
  @@index([createdAt])
}

model InquiryStatusHistory {
  id          Int      @id @default(autoincrement())
  inquiryId   Int
  fromStatus  String
  toStatus    String
  changedById Int
  remarks     String?
  createdAt   DateTime @default(now())
  changedBy   User     @relation(fields: [changedById], references: [id])
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([changedById])
  @@index([createdAt])
}

model SupplierQuote {
  id                 Int                 @id @default(autoincrement())
  supplierId         Int
  inquiryId          Int
  quoteAmount        Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @db.Decimal(12, 2)
  finalAmount        Decimal             @db.Decimal(12, 2)
  validityDate       DateTime?
  documentAttachment String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdById        Int?
  updatedById        Int?
  isActive           Boolean             @default(true)
  isSelected         Boolean             @default(false)
  inquiry            Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  items              SupplierQuoteItem[]

  @@index([supplierId])
  @@index([inquiryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model SupplierQuoteItem {
  id              Int           @id @default(autoincrement())
  supplierQuoteId Int
  inquiryItemId   Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  quantity        Int
  totalPrice      Decimal       @db.Decimal(12, 2)
  isSelected      Boolean       @default(false)
  inquiryItem     InquiryItem   @relation(fields: [inquiryItemId], references: [id])
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)

  @@index([supplierQuoteId])
  @@index([inquiryItemId])
}

model ClientQuotation {
  id                 Int                   @id @default(autoincrement())
  inquiryId          Int
  quotationNumber    String                @unique
  marginPercentage   Decimal               @db.Decimal(5, 2)
  discountPercentage Decimal               @default(0) @db.Decimal(5, 2)
  taxPercentage      Decimal               @db.Decimal(5, 2)
  totalAmount        Decimal               @db.Decimal(12, 2)
  finalAmount        Decimal               @db.Decimal(12, 2)
  status             String                @default("DRAFT")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  createdById        Int?
  updatedById        Int?
  isActive           Boolean               @default(true)
  inquiry            Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  items              ClientQuotationItem[]

  @@index([inquiryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model ClientQuotationItem {
  id                Int             @id @default(autoincrement())
  clientQuotationId Int
  inquiryItemId     Int
  sellingPrice      Decimal         @db.Decimal(12, 2)
  quantity          Int
  totalPrice        Decimal         @db.Decimal(12, 2)
  clientQuotation   ClientQuotation @relation(fields: [clientQuotationId], references: [id], onDelete: Cascade)
  inquiryItem       InquiryItem     @relation(fields: [inquiryItemId], references: [id])

  @@index([clientQuotationId])
  @@index([inquiryItemId])
}

model ApprovalLog {
  id           Int      @id @default(autoincrement())
  inquiryId    Int
  approvedById Int
  role         String
  status       String
  remarks      String?
  createdAt    DateTime @default(now())
  approvedBy   User     @relation(fields: [approvedById], references: [id])
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([approvedById])
  @@index([createdAt])
}

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  poNumber             String              @unique
  supplierId           Int
  clientId             Int
  inquiryId            Int?
  status               String              @default("PENDING")
  amount               Decimal             @db.Decimal(12, 2)
  expectedDeliveryDate DateTime?
  attachment           String?
  emailStatus          String              @default("PENDING")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  createdById          Int?
  updatedById          Int?
  isActive             Boolean             @default(true)
  client               Client              @relation(fields: [clientId], references: [id])
  inquiry              Inquiry?            @relation(fields: [inquiryId], references: [id])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  items                PurchaseOrderItem[]
  shipments            Shipment[]

  @@index([supplierId])
  @@index([clientId])
  @@index([inquiryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  description     String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
}

model Shipment {
  id                 Int            @id @default(autoincrement())
  shipmentNumber     String         @unique
  inquiryId          Int?
  purchaseOrderId    Int?
  supplierId         Int? // Optional: null for inventory-fulfilled orders (no external supplier)
  clientId           Int
  cargoDetails       String?
  vehicleDetails     String?
  driverDetails      String?
  loadingDate        DateTime?
  deliveryDate       DateTime?
  currentStatus      String         @default("PENDING")
  trackingRemarks    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  createdById        Int?
  updatedById        Int?
  isActive           Boolean        @default(true)
  inventoryFulfilled Boolean        @default(false) // marks inventory-sourced shipments
  invoices           Invoice[]
  client             Client         @relation(fields: [clientId], references: [id])
  inquiry            Inquiry?       @relation(fields: [inquiryId], references: [id])
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier           Supplier?      @relation(fields: [supplierId], references: [id])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  clientId       Int
  inquiryId      Int?
  shipmentId     Int?
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  pendingAmount  Decimal       @db.Decimal(12, 2)
  status         String        @default("DRAFT")
  paymentDetails Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  createdById    Int?
  updatedById    Int?
  isActive       Boolean       @default(true)
  client         Client        @relation(fields: [clientId], references: [id])
  inquiry        Inquiry?      @relation(fields: [inquiryId], references: [id])
  shipment       Shipment?     @relation(fields: [shipmentId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                   Int         @id @default(autoincrement())
  invoiceId            Int
  paymentDate          DateTime    @default(now())
  amount               Decimal     @db.Decimal(12, 2)
  paymentMode          String
  bankAccountId        Int
  transactionReference String?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  createdById          Int?
  updatedById          Int?
  isActive             Boolean     @default(true)
  bankAccount          BankAccount @relation(fields: [bankAccountId], references: [id])
  invoice              Invoice     @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([bankAccountId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model InventoryItem {
  id                Int              @id @default(autoincrement())
  itemName          String
  impa               String           @unique
  category          String?
  unit              String?
  sellingPrice      Decimal          @db.Decimal(12, 2)
  purchasePrice     Decimal          @db.Decimal(12, 2)
  minimumStockLevel Int              @default(5)
  status            String           @default("ACTIVE")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  createdById       Int?
  updatedById       Int?
  isActive          Boolean          @default(true)
  movements         StockMovement[]
  stocks            WarehouseStock[]

  @@index([createdById])
  @@index([updatedById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Warehouse {
  id             Int              @id @default(autoincrement())
  name           String
  location       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  createdById    Int?
  updatedById    Int?
  isActive       Boolean          @default(true)
  stockMovements StockMovement[]
  stocks         WarehouseStock[]

  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model WarehouseStock {
  id              Int           @id @default(autoincrement())
  warehouseId     Int
  inventoryItemId Int
  quantity        Int           @default(0)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, inventoryItemId])
  @@index([inventoryItemId])
}

model StockMovement {
  id                Int           @id @default(autoincrement())
  inventoryItemId   Int
  warehouseId       Int
  type              String
  quantity          Int
  previousQuantity  Int? // Stock level before this movement (for audit)
  remainingQuantity Int? // Stock level after this movement (for audit)
  referenceType     String?
  referenceId       Int?
  referenceNumber   String? // e.g. inquiry number for easy display
  actionBy          String? // System or user email for audit log
  remarks           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  createdById       Int?
  updatedById       Int?
  isActive          Boolean       @default(true)
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
}

model Employee {
  id          Int          @id @default(autoincrement())
  fullName    String
  email       String       @unique
  phone       String?
  department  String?
  designation String?
  roleId      Int?
  salary      Decimal?     @db.Decimal(12, 2)
  joiningDate DateTime?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  isActive    Boolean      @default(true)
  attendance  Attendance[]
  documents   Document[]   @relation("EmployeeDocuments")
  user        User?
  tasks       Task[]

  @@index([roleId])
  @@index([createdById])
  @@index([updatedById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Attendance {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  date         DateTime  @db.Date
  status       String
  checkInTime  DateTime?
  checkOutTime DateTime?
  remarks      String?
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([status])
}

model BankAccount {
  id                Int       @id @default(autoincrement())
  bankName          String
  accountHolderName String
  accountNumber     String    @unique
  routingNumber     String?
  swiftCode         String?
  currency          String    @default("INR")
  branch            String?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdById       Int?
  updatedById       Int?
  isActive          Boolean   @default(true)
  payments          Payment[]

  @@index([createdById])
  @@index([updatedById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Document {
  id           Int       @id @default(autoincrement())
  title        String
  category     String
  entityType   String
  entityId     Int
  expiryDate   DateTime?
  status       String    @default("VALID")
  filePath     String
  uploadedById Int
  employeeId   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  Int?
  updatedById  Int?
  isActive     Boolean   @default(true)
  employee     Employee? @relation("EmployeeDocuments", fields: [employeeId], references: [id])
  uploadedBy   User      @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([entityId])
  @@index([uploadedById])
  @@index([employeeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Notification {
  id              Int      @id @default(autoincrement())
  userId          Int
  title           String
  message         String
  type            String
  relatedModule   String?
  relatedRecordId Int?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  module    String
  action    String
  recordId  Int?
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Vehicle {
  id          Int       @id @default(autoincrement())
  vehicle_no  String    @unique
  type        String?
  capacity    String?
  driver_name String?
  phone       String?
  documents   Json?     @default("[]")
  status      String    @default("Active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  type       String   @default("text") // text, file, image
  fileName   String?
  fileSize   String?
  fileUrl    String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Task {
  id                 Int       @id @default(autoincrement())
  title              String
  description        String?
  status             String    @default("PENDING") // PENDING, CONFIRMED, COMPLETED
  priority           String    @default("MEDIUM")  // LOW, MEDIUM, HIGH
  dueDate            DateTime?
  assignedEmployeeId Int?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  emailId            String?   // Reference to the original email messageId
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([assignedEmployeeId])
  @@index([createdAt])
  @@index([deletedAt])
}

