datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User & Role-Based Access Control
model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String
  refreshToken          String?
  roleId                String
  role                  Role                   @relation(fields: [roleId], references: [id])
  
  // Auditing fields
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  createdById           String?
  updatedById           String?
  isActive              Boolean                @default(true)

  // Relations
  inquiriesCreated      Inquiry[]              @relation("InquiryCreator")
  inquiriesUpdated      Inquiry[]              @relation("InquiryUpdater")
  assignedInquiries     Inquiry[]              @relation("AssignedEmployee")
  assignedLeadInquiries Inquiry[]              @relation("AssignedLead")
  statusHistories       InquiryStatusHistory[]
  approvalLogs          ApprovalLog[]
  documentsUploaded     Document[]             @relation("DocumentUploader")
  notifications         Notification[]
  auditLogs             AuditLog[]
  employeeProfile       Employee?              @relation(fields: [employeeProfileId], references: [id])
  employeeProfileId     String?                @unique
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  isActive    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  module          String // e.g. inquiries, products, suppliers
  action          String // e.g. create, read, update, delete, approve, export
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isActive        Boolean          @default(true)
  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// Core CRM Entities
model Client {
  id             String           @id @default(uuid())
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?
  isActive       Boolean          @default(true)
  
  inquiries      Inquiry[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]
  invoices       Invoice[]
}

model Supplier {
  id             String           @id @default(uuid())
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?
  isActive       Boolean          @default(true)
  
  inquiries      InquirySupplier[]
  supplierQuotes SupplierQuote[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]
}

model Product {
  id                 String               @id @default(uuid())
  name               String
  sku                String               @unique
  category           String?
  unit               String?
  sellingPrice       Decimal              @db.Decimal(12, 2)
  purchasePrice      Decimal              @db.Decimal(12, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  isActive           Boolean              @default(true)
  
  inquiryItems       InquiryItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

// Inquiry Pipeline
model Inquiry {
  id                   String                 @id @default(uuid())
  inquiryNumber        String                 @unique // e.g. INQ-1001
  clientId             String
  client               Client                 @relation(fields: [clientId], references: [id])
  vesselName           String?
  referenceNumber      String?
  currentStatus        String                 @default("PENDING") // PENDING, RFQ_READY, RFQ_SENT, CLIENT_QUOTING, TL_REVIEW, ADMIN_APPROVAL, EMPLOYEE_VERIFY, CLIENT_FINAL_APPROVAL, QUOTE_SENT, CONFIRMED, CLOSED, REJECTED
  assignedEmployeeId   String?
  assignedEmployee     User?                  @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedTeamLeadId   String?
  assignedTeamLead     User?                  @relation("AssignedLead", fields: [assignedTeamLeadId], references: [id])
  expectedDeliveryDate DateTime?
  remarks              String?
  
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  createdById          String?
  createdBy            User?                  @relation("InquiryCreator", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            User?                  @relation("InquiryUpdater", fields: [updatedById], references: [id])
  isActive             Boolean                @default(true)

  items                InquiryItem[]
  suppliers            InquirySupplier[]
  statusHistory        InquiryStatusHistory[]
  supplierQuotes       SupplierQuote[]
  clientQuotations     ClientQuotation[]
  approvalLogs         ApprovalLog[]
  purchaseOrders       PurchaseOrder[]
  shipments            Shipment[]
  invoices             Invoice[]
}

model InquiryItem {
  id                   String                 @id @default(uuid())
  inquiryId            String
  inquiry              Inquiry                @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?               @relation(fields: [productId], references: [id])
  description          String
  quantity             Int
  unit                 String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  
  supplierQuoteItems   SupplierQuoteItem[]
  clientQuotationItems ClientQuotationItem[]
}

model InquirySupplier {
  id         String   @id @default(uuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  createdAt  DateTime @default(now())
}

model InquiryStatusHistory {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  remarks     String?
  createdAt   DateTime @default(now())
}

model SupplierQuote {
  id                 String              @id @default(uuid())
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  inquiryId          String
  inquiry            Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quoteAmount        Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @db.Decimal(12, 2)
  finalAmount        Decimal             @db.Decimal(12, 2)
  validityDate       DateTime?
  documentAttachment String?
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  isActive           Boolean             @default(true)
  
  items              SupplierQuoteItem[]
}

model SupplierQuoteItem {
  id              String        @id @default(uuid())
  supplierQuoteId String
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)
  inquiryItemId   String
  inquiryItem     InquiryItem   @relation(fields: [inquiryItemId], references: [id])
  unitPrice       Decimal       @db.Decimal(12, 2)
  quantity        Int
  totalPrice      Decimal       @db.Decimal(12, 2)
}

model ClientQuotation {
  id                 String                @id @default(uuid())
  inquiryId          String
  inquiry            Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quotationNumber    String                @unique // e.g. QT-1001
  marginPercentage   Decimal               @db.Decimal(5, 2)
  discountPercentage Decimal               @db.Decimal(5, 2) @default(0)
  taxPercentage      Decimal               @db.Decimal(5, 2)
  totalAmount        Decimal               @db.Decimal(12, 2)
  finalAmount        Decimal               @db.Decimal(12, 2)
  status             String                @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  isActive           Boolean               @default(true)

  items              ClientQuotationItem[]
}

model ClientQuotationItem {
  id                String          @id @default(uuid())
  clientQuotationId String
  clientQuotation   ClientQuotation @relation(fields: [clientQuotationId], references: [id], onDelete: Cascade)
  inquiryItemId     String
  inquiryItem       InquiryItem     @relation(fields: [inquiryItemId], references: [id])
  sellingPrice      Decimal         @db.Decimal(12, 2)
  quantity          Int
  totalPrice        Decimal         @db.Decimal(12, 2)
}

model ApprovalLog {
  id           String   @id @default(uuid())
  inquiryId    String
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  approvedById String
  approvedBy   User     @relation(fields: [approvedById], references: [id])
  role         String
  status       String // APPROVED, REJECTED
  remarks      String?
  createdAt    DateTime @default(now())
}

// Purchase Orders (POs)
model PurchaseOrder {
  id                   String              @id @default(uuid())
  poNumber             String              @unique // e.g. PO-1001
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  clientId             String
  client               Client              @relation(fields: [clientId], references: [id])
  inquiryId            String?
  inquiry              Inquiry?            @relation(fields: [inquiryId], references: [id])
  status               String              @default("PENDING") // PENDING, CONFIRMED, SHIPPED, CLOSED, CANCELLED
  amount               Decimal             @db.Decimal(12, 2)
  expectedDeliveryDate DateTime?
  attachment           String?
  emailStatus          String              @default("PENDING") // PENDING, SENT
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  createdById          String?
  updatedById          String?
  isActive             Boolean             @default(true)

  items                PurchaseOrderItem[]
  shipments            Shipment[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  description     String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
}

// Supply & Shipments
model Shipment {
  id              String          @id @default(uuid())
  shipmentNumber  String          @unique // e.g. SH-1001
  inquiryId       String?
  inquiry         Inquiry?        @relation(fields: [inquiryId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  cargoDetails    String?
  vehicleDetails  String?
  driverDetails   String?
  loadingDate     DateTime?
  deliveryDate    DateTime?
  currentStatus   String          @default("PENDING") // PENDING, LOADING, IN_TRANSIT, DELIVERED, INVOICE_SENT, CLOSED
  trackingRemarks String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  isActive        Boolean         @default(true)
  
  invoices        Invoice[]
}

// Billing, Invoicing & Payments
model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. INV-1001
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  inquiryId     String?
  inquiry       Inquiry?      @relation(fields: [inquiryId], references: [id])
  shipmentId    String?
  shipment      Shipment?     @relation(fields: [shipmentId], references: [id])
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @db.Decimal(12, 2) @default(0)
  pendingAmount Decimal       @db.Decimal(12, 2)
  status        String        @default("DRAFT") // DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  isActive      Boolean       @default(true)

  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
}

model Payment {
  id                   String      @id @default(uuid())
  invoiceId            String
  invoice              Invoice     @relation(fields: [invoiceId], references: [id])
  paymentDate          DateTime    @default(now())
  amount               Decimal     @db.Decimal(12, 2)
  paymentMode          String // BANK_TRANSFER, CASH, CHEQUE, etc.
  bankAccountId        String
  bankAccount          BankAccount @relation(fields: [bankAccountId], references: [id])
  transactionReference String?
  notes                String?
  
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  createdById          String?
  updatedById          String?
  isActive             Boolean     @default(true)
}

// Inventory & Warehouse Ledger
model InventoryItem {
  id                String           @id @default(uuid())
  itemName          String
  sku               String           @unique
  category          String?
  unit              String?
  sellingPrice      Decimal          @db.Decimal(12, 2)
  purchasePrice     Decimal          @db.Decimal(12, 2)
  minimumStockLevel Int              @default(5)
  status            String           @default("ACTIVE") // ACTIVE, INACTIVE
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  createdById       String?
  updatedById       String?
  isActive          Boolean          @default(true)

  stocks            WarehouseStock[]
  movements         StockMovement[]
}

model Warehouse {
  id             String           @id @default(uuid())
  name           String
  location       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?
  isActive       Boolean          @default(true)

  stocks         WarehouseStock[]
  stockMovements StockMovement[]
}

model WarehouseStock {
  id              String        @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int           @default(0)

  @@unique([warehouseId, inventoryItemId])
}

model StockMovement {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type            String // IN, OUT, ADJUSTMENT, RESERVED, RELEASED
  quantity        Int
  referenceType   String? // INQUIRY, PO, INVOICE, ADJUSTMENT
  referenceId     String?
  remarks         String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  isActive        Boolean       @default(true)
}

// Employees Registry & Attendance
model Employee {
  id          String       @id @default(uuid())
  fullName    String
  email       String       @unique
  phone       String?
  department  String?
  designation String?
  roleId      String?
  salary      Decimal?     @db.Decimal(12, 2)
  joiningDate DateTime?
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  isActive    Boolean      @default(true)

  attendance  Attendance[]
  user        User?
  documents   Document[]   @relation("EmployeeDocuments")
}

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  status       String // PRESENT, LATE, SICK_LEAVE, OFF_DAY
  checkInTime  DateTime?
  checkOutTime DateTime?
  remarks      String?

  @@unique([employeeId, date])
}

// Bank Accounts
model BankAccount {
  id                String    @id @default(uuid())
  bankName          String
  accountHolderName String
  accountNumber     String    @unique
  routingNumber     String?
  swiftCode         String?
  currency          String    @default("INR")
  branch            String?
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdById       String?
  updatedById       String?
  isActive          Boolean   @default(true)

  payments          Payment[]
}

// Document Management
model Document {
  id          String    @id @default(uuid())
  title       String
  category    String // VISA, LICENSE, CONTRACT, INSURANCE, etc.
  entityType  String // EMPLOYEE, VEHICLE, COMPANY, SUPPLIER, CLIENT, INQUIRY, PO, INVOICE
  entityId    String
  expiryDate  DateTime?
  status      String    @default("VALID") // VALID, EXPIRING_SOON, EXPIRED
  filePath    String
  
  uploadedById String
  uploadedBy   User      @relation("DocumentUploader", fields: [uploadedById], references: [id])
  employeeId   String?
  employee     Employee? @relation("EmployeeDocuments", fields: [employeeId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  isActive    Boolean   @default(true)
}

// System Notifications
model Notification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            String // inquiry, purchase-order, document, supply, system
  relatedModule   String?
  relatedRecordId String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Audit Logs
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  module       String
  action       String // login, create, update, delete, approval, status change, payment, permission change
  recordId     String?
  oldValue     String?  @db.Text
  newValue     String?  @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}
