# Server configuration
PORT=5000
NODE_ENV=development

# Database connection string (PostgreSQL)
# Note: Always include ?connection_limit=N tuned to your deployment's capacity. 
# A good starting point for a single backend instance is 20.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_erp?schema=public&connection_limit=20

# JWT Authentication Secrets
JWT_SECRET=your_jwt_access_secret_key_change_me_in_production
REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Allow-list (comma-separated origins)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
STRICT_RATE_LIMIT_WINDOW_MS=60000
STRICT_RATE_LIMIT_MAX=10
